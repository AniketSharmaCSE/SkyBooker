{
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/auth/{**catch-all}"
        }
      },
      "auth-ui-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/auth-ui/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/auth-ui"
          }
        ]
      },
      "flight-route": {
        "ClusterId": "flight-cluster",
        "Match": {
          "Path": "/flights/{**catch-all}",
          "Methods": [ "GET" ]
        }
      },
      "flight-protected-route": {
        "ClusterId": "flight-cluster",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/flights/{**catch-all}"
        }
      },
      "flight-ui-route": {
        "ClusterId": "flight-cluster",
        "Match": {
          "Path": "/flight-ui/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/flight-ui"
          }
        ]
      },
      "seat-route": {
        "ClusterId": "seat-cluster",
        "Match": {
          "Path": "/seats/{**catch-all}",
          "Methods": [ "GET" ]
        }
      },
      "seat-protected-route": {
        "ClusterId": "seat-cluster",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/seats/{**catch-all}"
        }
      },
      "seat-ui-route": {
        "ClusterId": "seat-cluster",
        "Match": {
          "Path": "/seat-ui/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/seat-ui"
          }
        ]
      },
      "booking-route": {
        "ClusterId": "booking-cluster",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/bookings/{**catch-all}"
        }
      },
      "booking-ui-route": {
        "ClusterId": "booking-cluster",
        "Match": {
          "Path": "/booking-ui/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/booking-ui"
          }
        ]
      },
      "passenger-route": {
        "ClusterId": "passenger-cluster",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/passengers/{**catch-all}"
        }
      },
      "passenger-ui-route": {
        "ClusterId": "passenger-cluster",
        "Match": {
          "Path": "/passenger-ui/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/passenger-ui"
          }
        ]
      },
      "notification-route": {
        "ClusterId": "notification-cluster",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/notifications/{**catch-all}"
        }
      },
      "notification-ui-route": {
        "ClusterId": "notification-cluster",
        "Match": {
          "Path": "/notification-ui/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/notification-ui"
          }
        ]
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "auth": {
            "Address": "http://auth-service:8080/"
          }
        }
      },
      "flight-cluster": {
        "Destinations": {
          "flight": {
            "Address": "http://flight-service:8080/"
          }
        }
      },
      "seat-cluster": {
        "Destinations": {
          "seat": {
            "Address": "http://seat-service:8080/"
          }
        }
      },
      "booking-cluster": {
        "Destinations": {
          "booking": {
            "Address": "http://booking-service:8080/"
          }
        }
      },
      "passenger-cluster": {
        "Destinations": {
          "passenger": {
            "Address": "http://passenger-service:8080/"
          }
        }
      },
      "notification-cluster": {
        "Destinations": {
          "notification": {
            "Address": "http://notification-service:8080/"
          }
        }
      }
    }
  },
  "Jwt": {
    "Key": "AirlineBooking_SuperSecret_JWT_Key_2024!",
    "Issuer": "AuthService",
    "Audience": "AirlineBookingApp"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*"
}
